# Copy to .env for local dev (netlify dev). In production, set these in
# Netlify → Site configuration → Environment variables (scope: Functions).
GEMINI_API_KEY=your-free-key-from-aistudio.google.com
# Optional — add any provider you want to use site-wide:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# Optional: require this code in Settings before anyone can generate.
ACCESS_CODE=
